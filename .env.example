# ── ClickHouse ────────────────────────────────────────────────
CLICKHOUSE_USER=argosuy
CLICKHOUSE_PASSWORD=changeme

# ── GitHub ────────────────────────────────────────────────────
# Personal access token — needs read:user, read:org, public_repo scopes
GITHUB_TOKEN=ghp_...

# ── App ───────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Prefect (optional) ────────────────────────────────────────
# Leave empty to run flows with a local ephemeral server (no Prefect Cloud needed)
PREFECT_API_URL=
